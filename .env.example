# rick-server — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Open WebUI ---
OPENWEBUI_PORT=3000
# Random secret for session signing. Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-openssl-rand-hex-32

# --- Ollama (runs natively on the host, owns the GPUs) ---
# From inside containers, reach the host's Ollama via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- RAG embeddings (reuse the host's Ollama embedder; no extra downloads) ---
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text

# --- Your private rick_mcp content (identity / soul / vault) ---
# Clone your private ~/.rick_mcp repo on the host, then point here.
RICK_MCP_HOME=/home/CHANGEME/.rick_mcp

# --- rick-tools (mcpo: exposes the rick_* MCP tools as OpenAPI) ---
MCPO_PORT=8001
# Auth key for the tools endpoint. Generate: openssl rand -hex 24
MCPO_API_KEY=change-me-openssl-rand-hex-24

# --- Vault ingest (scripts/ingest-vault.sh) ---
# Create in Open WebUI: Settings > Account > API Keys. Leave blank until then.
OPENWEBUI_API_KEY=
